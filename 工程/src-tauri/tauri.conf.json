{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acorn",
  "version": "1.15.0",
  "identifier": "com.cdpandas.acorn",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "橡果 Acorn",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "quickadd",
        "title": "随手记一条",
        "url": "quickadd.html",
        "width": 640,
        "height": 210,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      },
      {
        "label": "focus",
        "title": "专注",
        "url": "focus.html",
        "width": 300,
        "height": 104,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "eye-care",
        "title": "护眼休息",
        "url": "eye-care.html",
        "width": 400,
        "height": 280,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      },
      {
        "label": "guide",
        "title": "一句话记事",
        "url": "guide.html",
        "width": 720,
        "height": 820,
        "minWidth": 420,
        "minHeight": 420,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
