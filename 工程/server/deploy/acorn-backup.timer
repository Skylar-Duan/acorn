# 每天北京 03:40（服务器时区就是 Asia/Shanghai；错开 10 的 cdp-pgbackup 03:30）。
# Persistent=true：关机错过的那次，开机后补跑一次。安装：deploy/install-backup.sh

[Unit]
Description=Daily Acorn sync DB backup (03:40 Beijing)

[Timer]
OnCalendar=*-*-* 03:40:00 Asia/Shanghai
Persistent=true
Unit=acorn-backup.service

[Install]
WantedBy=timers.target
